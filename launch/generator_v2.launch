<?xml version="1.0"?>
<launch>
  
  <!-- <env name="GAZEBO_PLUGIN_PATH" value="$(find arvc_gazebo_ros_plugins)/" /> -->
  <env name="GAZEBO_MODEL_PATH" value="$(find arvc_dataset_generator)" />



  <!-- We resume the logic in empty_world.launch, changing only the name of the world to be launched -->
  <include file="$(find arvc_dataset_generator)/launch/empty_world.launch">
    <!-- <arg name="world_name" value="$(find arvc_gazebo_ros_plugins)/worlds/empty_world.world"/> -->
    <arg name="world_name" value="$(find arvc_dataset_generator)/worlds/test_plugin.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="recording" value="false"/>
    <arg name="debug" value="false"/>
  </include>

</launch>